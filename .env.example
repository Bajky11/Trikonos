# Copy to .env.production. This file contains no usable production secrets.
# Generate independent random values, e.g. with: openssl rand -hex 32
DJANGO_SECRET_KEY=
POSTGRES_PASSWORD=

# Public hostname of the BACKEND, without scheme or path.
DJANGO_ALLOWED_HOSTS=api.example.com
# Browser API origin, baked into the frontend image; rebuild after changing it.
VITE_API_BASE_URL=https://api.example.com
# Exact frontend origins allowed to call the API with cookies (comma-separated).
FRONTEND_ORIGINS=https://shop.example.com
FRONTEND_URL=https://shop.example.com
POSTGRES_DB=trikonos
POSTGRES_USER=trikonos

# Loopback ports for a trusted HTTPS reverse proxy on the host.
FRONTEND_PORT=8080
BACKEND_PORT=8000

# Until SMTP is configured, messages go only to container logs.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=noreply@example.com

# Public URL of approved terms; the frontend disables checkout if empty.
SHOP_TERMS_URL=
# Only for an isolated test or staging instance; never enable on the live store.
COMGATE_TEST_ENABLED=false
COMGATE_MERCHANT=
COMGATE_SECRET=
# Veřejný API klíč widgetu Zásilkovny (nikoli API heslo pro expedici).
PACKETA_WIDGET_API_KEY=
SHOP_BANK_ACCOUNT=
SHOP_CONTACT_EMAIL=
SHOP_CONTACT_PHONE=
SHOP_NOTIFY_EMAIL=
