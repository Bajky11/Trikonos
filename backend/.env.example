DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

DB_NAME=trikonos
DB_USER=trikonos
DB_PASSWORD=trikonos
DB_HOST=localhost
DB_PORT=5432

FRONTEND_ORIGINS=http://localhost:5173
FRONTEND_URL=http://localhost:5173
# Lax for same-domain frontend; None (requires HTTPS) if frontend is on a
# different domain than this API.
COOKIE_SAMESITE=Lax

SHOP_NAME=Trikonoš.cz
SHOP_CONTACT_EMAIL=info@trikonos.cz
SHOP_CONTACT_PHONE=
SHOP_INSTAGRAM_URL=
SHOP_BANK_ACCOUNT=
SHOP_TOPBAR_TEXT=
SHOP_NOTIFY_EMAIL=info@trikonos.cz

EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=info@trikonos.cz

# Used only by `python manage.py seed_initial` to create the first admin.
ADMIN_EMAIL=admin@trikonos.cz
ADMIN_PASSWORD=change-me
ADMIN_NAME=Admin

# Public URL of approved terms; the frontend disables checkout if empty.
SHOP_TERMS_URL=
COMGATE_TEST_ENABLED=false
COMGATE_MERCHANT=
COMGATE_SECRET=
# Veřejný API klíč widgetu Zásilkovny (nikoli API heslo pro expedici).
PACKETA_WIDGET_API_KEY=

# POHODA mServer - vystavení vydané faktury po admin potvrzení objednávky.
# POHODA_ENABLED=false nechá požadavky čekat v DB, aniž by cokoliv volal -
# bezpečný výchozí stav, dokud není mServer na klientově síti připravený.
# Heslo je tajné, jde jen sem do env, nikdy do DB/kódu.
POHODA_ENABLED=false
POHODA_URL=http://localhost:444/xml
POHODA_USERNAME=
POHODA_PASSWORD=
POHODA_ICO=
POHODA_APPLICATION_NAME=Trikonoš e-shop
# Číselná řada, předkontace a členění DPH dodá klientova účetní - prázdné
# hodnoty se do XML nevkládají a POHODA použije svůj výchozí nastavení agendy.
POHODA_NUMBERING_SERIES=
POHODA_PRE_ACCOUNTING=
POHODA_VAT_CLASSIFICATION=
# Jedna pevná sazba DPH pro celou fakturu - e-shop neukládá sazbu DPH ani
# net/gross rozpad, jen finální ceny. POHODA_VAT_RATE_CODE musí odpovídat
# kódu sazby v konkrétní instalaci POHODY (ověřit na testovací účetní jednotce).
POHODA_VAT_RATE_PERCENT=21
POHODA_VAT_RATE_CODE=high
# Číslo tiskové sestavy pro XML tisk vydané faktury do PDF - specifické pro
# instalaci/úpravy klienta, dodá klient.
POHODA_PRINT_REPORT_ID=
POHODA_CONNECT_TIMEOUT=5
POHODA_READ_TIMEOUT=30
